# Server
PORT=3000
SITE_URL=https://digitalmind-xi.vercel.app/

# Checkout
PAYMENT_URL=https://digitalmind-xi.vercel.app/checkouts
PAYMENT_PROVIDER=razorpay
PRODUCT_ID=50-micro-saas-ebook
PRODUCT_NAME=50 Micro SaaS You Can Build Without Coding
PRODUCT_AMOUNT=₹ 99
PRODUCT_CURRENCY=INR

# Razorpay
# RAZORPAY_KEY_ID is public enough for Checkout, but keep it in env config.
# RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET must never be exposed to frontend code.
RAZORPAY_KEY_ID=replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# Stripe verification
PAYMENT_SECRET_KEY=sk_live_replace_me
PAYMENT_WEBHOOK_SECRET=whsec_replace_me

# Private ebook storage
# This path is server-only. Do not place the ebook in /public.
EBOOK_STORAGE_PATH=private/50-micro-saas.pdf

# Download token settings
DOWNLOAD_TOKEN_TTL_HOURS=168
